      "request": {"operation": "cadence", "progression_size": 3, "state_present": true, "identity_matches": true, "applied_index": -1, "current_cadence_acknowledged": false, "advance_same_identity": true, "applied_interval_elapsed": true, "has_host_update_failures": true},
      "expected_result": {"operation": "cadence", "current_index": 0, "state_status": "same_identity", "transition": "retry_unacknowledged_failure", "current_cadence_acknowledged": false}
