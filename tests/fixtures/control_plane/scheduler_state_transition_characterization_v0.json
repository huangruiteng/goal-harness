      "request": {"operation": "host", "state_status": "same_identity", "observed_host_rrule_present": true, "current_rrule_already_applied": true, "scheduler_state_acknowledges_current_rrule": true, "current_target_has_failure": true, "repeated_failed_pair": false},
      "expected_result": {"operation": "host", "transition": "host_match_ack_required", "current_target_has_failure": true, "repeated_failed_pair": false}
