{
  "schema_version": "loopx_scheduler_state_transition_characterization_v0",
  "source_baseline": "3f923c4fe",
  "cases": [
    {
      "name": "missing_state_starts_at_initial",
      "request": {"operation": "cadence", "progression_size": 3, "state_present": false, "identity_matches": false, "applied_index": -1, "current_cadence_acknowledged": false, "advance_same_identity": true, "applied_interval_elapsed": true, "has_host_update_failures": false},
      "expected_result": {"operation": "cadence", "current_index": 0, "state_status": "missing", "transition": "initial", "current_cadence_acknowledged": false}
    },
    {
      "name": "changed_identity_resets_to_initial",
      "request": {"operation": "cadence", "progression_size": 3, "state_present": true, "identity_matches": false, "applied_index": 1, "current_cadence_acknowledged": true, "advance_same_identity": true, "applied_interval_elapsed": true, "has_host_update_failures": false},
      "expected_result": {"operation": "cadence", "current_index": 0, "state_status": "reset_required", "transition": "identity_reset", "current_cadence_acknowledged": false}
    },
    {
      "name": "unacknowledged_failure_retries_current_index",
      "request": {"operation": "cadence", "progression_size": 3, "state_present": true, "identity_matches": true, "applied_index": 1, "current_cadence_acknowledged": false, "advance_same_identity": true, "applied_interval_elapsed": true, "has_host_update_failures": true},
      "expected_result": {"operation": "cadence", "current_index": 1, "state_status": "same_identity", "transition": "retry_unacknowledged_failure", "current_cadence_acknowledged": false}
    },
    {
      "name": "acknowledged_failure_can_advance_after_interval",
      "request": {"operation": "cadence", "progression_size": 3, "state_present": true, "identity_matches": true, "applied_index": 1, "current_cadence_acknowledged": true, "advance_same_identity": true, "applied_interval_elapsed": true, "has_host_update_failures": true},
      "expected_result": {"operation": "cadence", "current_index": 2, "state_status": "same_identity", "transition": "advance_after_interval", "current_cadence_acknowledged": true}
    },
    {
      "name": "active_work_holds_initial_cadence",
      "request": {"operation": "cadence", "progression_size": 3, "state_present": true, "identity_matches": true, "applied_index": 2, "current_cadence_acknowledged": true, "advance_same_identity": false, "applied_interval_elapsed": true, "has_host_update_failures": false},
      "expected_result": {"operation": "cadence", "current_index": 0, "state_status": "same_identity", "transition": "hold_active_initial", "current_cadence_acknowledged": true}
    },
    {
      "name": "settled_cadence_holds_until_interval_elapsed",
      "request": {"operation": "cadence", "progression_size": 3, "state_present": true, "identity_matches": true, "applied_index": 1, "current_cadence_acknowledged": true, "advance_same_identity": true, "applied_interval_elapsed": false, "has_host_update_failures": false},
      "expected_result": {"operation": "cadence", "current_index": 1, "state_status": "same_identity", "transition": "hold_until_interval", "current_cadence_acknowledged": true}
    },
    {
      "name": "elapsed_terminal_index_stays_capped",
      "request": {"operation": "cadence", "progression_size": 3, "state_present": true, "identity_matches": true, "applied_index": 2, "current_cadence_acknowledged": true, "advance_same_identity": true, "applied_interval_elapsed": true, "has_host_update_failures": false},
      "expected_result": {"operation": "cadence", "current_index": 2, "state_status": "same_identity", "transition": "advance_after_interval", "current_cadence_acknowledged": true}
    },
    {
      "name": "invalid_failed_index_recovers_at_initial",
      "request": {"operation": "cadence", "progression_size": 3, "state_present": true, "identity_matches": true, "applied_index": -1, "current_cadence_acknowledged": false, "advance_same_identity": true, "applied_interval_elapsed": true, "has_host_update_failures": true},
