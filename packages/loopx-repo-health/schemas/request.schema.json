{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "owner": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "repo": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "schema_version": {
      "const": "loopx_repo_health_request_v0"
    }
  },
  "required": [
    "schema_version",
    "owner",
    "repo"
  ],
  "type": "object"
}
