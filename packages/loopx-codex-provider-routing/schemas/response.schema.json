{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "error": false,
        "ok": {
          "const": true
        }
      },
      "required": [
        "request_schema_version",
        "operation",
        "result"
      ]
    },
    {
      "properties": {
        "ok": {
          "const": false
        },
        "operation": false,
        "request_schema_version": false,
        "result": false
      },
      "required": [
        "error"
      ]
    }
  ],
  "properties": {
    "error": {
      "minLength": 1,
      "type": "string"
    },
    "extension_id": {
      "const": "loopx-codex-provider-routing"
    },
    "ok": {
      "type": "boolean"
    },
    "operation": {
      "enum": [
        "compile_catalog",
        "normalize_selector_request",
        "project_runtime_status",
        "qualify_desktop_patch",
        "qualify_heartbeat_transport",
        "qualify_host_control_recovery",
        "qualify_outage_recovery",
        "qualify_quota_recovery",
        "qualify_snapshot",
        "qualify_tool_transport",
        "reconcile_integration_candidate",
        "upgrade_plan"
      ]
    },
    "request_schema_version": {
      "const": "loopx_codex_provider_routing_request_v0"
    },
    "result": {
      "type": "object"
    },
    "schema_version": {
      "const": "loopx_codex_provider_routing_response_v0"
    }
  },
  "required": [
    "ok",
    "schema_version",
    "extension_id"
  ],
  "type": "object"
}
