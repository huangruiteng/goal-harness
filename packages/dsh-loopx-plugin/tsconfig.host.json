{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "declarationDir": "./lib/types",
    "outDir": "./build-temp/host",
    "rootDir": "./src",
    "sourceMap": false,
    "tsBuildInfoFile": "./build-temp/host.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/client/**/*", "tests"]
}
